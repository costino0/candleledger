# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=3001

# PostgreSQL connection string for your hosted development database (e.g. Neon).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/candleledger?sslmode=require"
