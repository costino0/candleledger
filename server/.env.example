# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=3001

# PostgreSQL connection string for your hosted development database (e.g. Neon).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# About sslmode (tested with pg 8.23 and Prisma 7.10):
# - The app and scripts (pg driver) treat `require` exactly like `verify-full`: the
#   connection is encrypted and the server certificate is verified. pg prints a
#   "SECURITY WARNING" about this at startup; with `require` it is informational only.
# - The Prisma CLI (migrate, db seed) accepts both `require` and `verify-full` and connects
#   over SSL with either.
# `sslmode=verify-full` behaves the same and avoids the warning.
DATABASE_URL="postgresql://user:password@host:5432/candleledger?sslmode=require"
